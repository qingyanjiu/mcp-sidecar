# ============================================================================
# 完整栈（agentic-app + mcp-sidecar）的环境变量样例
# ----------------------------------------------------------------------------
# 用法：
#   cp env.docker.example .env        # 同名覆盖，Compose 会自动读取同目录的 .env
#   docker compose up -d
#
# 格式规则：
#   - 一行一个 KEY=VALUE，等号两边不要留空格；
#   - 行首加 # 就是注释；值里不要加引号（除非值本身含空格）；
#   - 这里留空 = 交给 docker-compose.yml 里的默认值（${VAR:-默认值}）；
#   - 优先级：命令行 env > .env > docker-compose.yml 里的默认值。
#   - 下面每个变量都对应 compose 里的一个 ${...}，改名会失效。
#
# Windows 提示：路径用正斜杠，例如 D:/work/AI/agentic-app；
#   并把 docker-compose.yml / .env / scripts/docker-start.sh 存成 LF 换行。
# ============================================================================

# ----------------------------------------------------------------------------
# 一、镜像（docker load 之后的实际 tag，不是文件路径）
# ----------------------------------------------------------------------------
# app 用的 python 镜像。注意：qingyanjiu/langchain:1.0.3 里没装 pymysql，
#   走 memory_persistor=mysql 相关导入会崩；langchain:slim 有装。
AGENTIC_IMAGE=qingyanjiu/langchain:slim
# mcp-sidecar 的 Java 镜像（本地现在叫 qingyanjiu/agent-mcp，按 docker images 里实际的填）
MCP_IMAGE=qingyanjiu/mcp-sidecar:latest
# 可选 redis 服务用的镜像（--profile redis 时才用）
REDIS_IMAGE=redis:6-alpine

# ----------------------------------------------------------------------------
# 二、代码目录（宿主机绝对路径，挂在容器里；改代码不用重建镜像）
# ----------------------------------------------------------------------------
# app 仓库根目录 → 容器内 /root/agentic-app（内含启动脚本与意图模型）
AGENTIC_CODE_DIR=/Users/louisliu/dev/AI_projects/agentic-app
# 运行态目录 → 容器内 /app（内含 mcp-sidecar.jar + application-server.yml）
# 换了 jar 只需 cp target/mcp-sidecar.jar deploy/，再 docker compose restart mcp-sidecar
MCP_CODE_DIR=/Users/louisliu/dev/AI_projects/mcp-sidecar

# ----------------------------------------------------------------------------
# 三、端口（只有 mcp-sidecar 对宿主机发布，app 的 8001 只在容器网络内）
# ----------------------------------------------------------------------------
# MCP 接口对外端口（含 /mcp/*、/llm/chat、/llm/gen_doc 等）
MCP_PORT=2222
# 监控端口（/actuator/health 等）
MONITOR_PORT=9970
# app 自身端口（容器内用，不发布到宿主机；改了要同时确认 sidecar 的上游地址跟着变）
APP_PORT=8001

# ----------------------------------------------------------------------------
# 四、运行环境
# ----------------------------------------------------------------------------
TZ=Asia/Shanghai
# HuggingFace 下载镜像地址（首次下载模型时用）
HF_ENDPOINT=https://hf-mirror.com
# 容器退出策略：unless-stopped（挂了自动重启）/ always / on-failure / no
RESTART_POLICY=unless-stopped
# Spring profile：server=读 deploy/application-server.yml；local=读 application-local.yml
SPRING_PROFILES_ACTIVE=server
# JVM 参数（通过 JAVA_TOOL_OPTIONS 生效），留空=容器感知的默认堆
#   例：-Xms512m -Xmx1536m
JAVA_TOOL_OPTIONS=

# ----------------------------------------------------------------------------
# 五、app 启动脚本（scripts/docker-start.sh）的行为开关
# ----------------------------------------------------------------------------
# true=uvicorn --reload（改代码自动重载，开发用；生产别开）
RELOAD=false
# 1=每次启动前 pip install -r requirements.txt（镜像缺依赖时的临时解法，需要网络）
INSTALL_DEPS=0
# 启动前等待依赖可达，逗号分隔 host:port；不通就按 WAIT_TIMEOUT 超时后退出
#   例：WAIT_FOR_HOST=host.docker.internal:6379,redis:6379
WAIT_FOR_HOST=
# 每个依赖的最长等待秒数
WAIT_TIMEOUT=60
# 追加给 uvicorn 的参数，例：--log-level warning
EXTRA_UVICORN_ARGS=

# ----------------------------------------------------------------------------
# 六、路由模式（决定启动后聊天走哪条链路）
# ----------------------------------------------------------------------------
# loop   = 全量走 LOOP 新链路（等价 LOOP_ROLLOUT_ENABLED=1 + PERCENT=100）
# legacy = 全部走旧逻辑（灰度变量一律失效）
# auto   = 按灰度变量 LOOP_ROLLOUT_ENABLED / LOOP_ROLLOUT_PERCENT / LOOP_ROLLOUT_USERS 判定
# 单请求仍可用 payload 的 mode=loop / mode=legacy 临时覆盖；改完重启生效
AGENT_MODE=auto

# ----------------------------------------------------------------------------
# 七、redis（sidecar 用；Spring Boot 3 只认 spring.data.redis.*，这里用 env 覆盖）
# ----------------------------------------------------------------------------
# 想连"本文件自带的 redis 容器"，三件事一起做：
#   1) 取消下面 COMPOSE_PROFILES 的注释（没有 profile 就不起 redis 容器）
#   2) REDIS_HOST=redis
#   3) docker compose up -d
# COMPOSE_PROFILES=redis
#
# 连宿主机上的 redis：REDIS_HOST=host.docker.internal
# 连外部 redis：REDIS_HOST=10.x.x.x + REDIS_PASSWORD=xxx
# 保持 localhost 则等于连容器自己的 6379（一般连不上，health 会显示 redis DOWN）
REDIS_HOST=localhost
REDIS_PORT=6379
# 自带 redis 没设密码时必须留空；外部 redis 有密码就填这里
REDIS_PASSWORD=
REDIS_DATABASE=10

# ----------------------------------------------------------------------------
# 八、app 业务配置
# ----------------------------------------------------------------------------
# 模型密钥：统一只用 OPENAI_API_KEY（SILICON_API_KEY 已从代码里删除）
#   填 DeepSeek / 任意 OpenAI 兼容服务的 key；留空则模型能力不可用
OPENAI_API_KEY=
# 可选：单独给 agent.loop.cli 用的 key，不填则回退 OPENAI_API_KEY
LLM_API_KEY=
# 模型服务地址与模型名（覆盖代码里的默认值）
LLM_BASE_URL=
LLM_MODEL=
LLM_THINKING=
LLM_REASONING_EFFORT=
# 意图识别模型目录（容器内路径）。已随项目提供：
#   agent/intent/models/BAAI_bge-small-zh-v1.5
# 置空则回落到让 sentence-transformers 自己去 HuggingFace 下载（离线环境会失败）
INTENT_MODEL_PATH=/root/agentic-app/agent/intent/models/BAAI_bge-small-zh-v1.5
# UE 场景控制的 MCP 端点，和业务域同一个 sidecar:2222，只是路径是 /mcp/scene。
# 宿主机/外网调试时可改成 http://10.204.146.44:2222/mcp/scene；置空则回落到
# mcp_client/mcp_server_config.yaml 里的 scene.url
SCENE_MCP_URL=http://mcp-sidecar:2222/mcp/scene
# 启动后台预热（场景 MCP 握手 + 各域图编译）：1=开，0=关。关掉则首个用户承担加载耗时
PREWARM_ON_STARTUP=
