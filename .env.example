# 复制为 .env 后填写；.env 已被 .gitignore 忽略。
#
# 两个坑先说清楚：
#   1. 注释一律单独成行，不要写在 KEY=value 后面（dotenv 会把 # 后面的内容当成值）。
#   2. **MCP_RAGFLOW_BASE_URL 必须是「sidecar 容器内可达」的地址**。
#      localhost / 127.0.0.1 指的是 sidecar 容器自己，不是宿主机，
#      填 localhost:9380 会让 /mcp/knowledge 的 searchKnowledge 恒返回
#      Connection refused。按部署形态选一种写法：
#        同一 docker 网络里的服务   → http://ragflow:9380
#        RAGFlow 跑在宿主机        → http://host.docker.internal:9380
#                                    （Linux 需给 sidecar 加
#                                      extra_hosts: ["host.docker.internal:host-gateway"]）
#        局域网另一台机器          → http://10.x.x.x:9380
#      改完 docker compose up -d 重建容器才生效（restart 不会重读 .env 的新值）。
#
# 本文件是 .env 的「敏感信息部分」，与 env.docker.example（非敏感部分）组合后
# 写入 docker-compose.yml 同目录的 .env：
#   cat env.docker.example .env.example > .env
# 完整部署步骤见 deploy/部署说明.md。

# ---- 平台接口 ----
MCP_PLATFORM_BASE_URL=
# 见文件头的可达性说明（容器内视角，不是宿主机视角）
MCP_RAGFLOW_BASE_URL=
MCP_RAGFLOW_API_KEY=
LLM_AUTH_URL=

# ---- 本地 profile 覆盖（仅 IDE 本地运行使用，SPRING_PROFILES_ACTIVE=local） ----
# 注意：application-local.yml 的 RAGFlow 占位符是
# ${LOCAL_MCP_RAGFLOW_BASE_URL:${MCP_RAGFLOW_BASE_URL:}}——LOCAL_* 为空会回落到
# 上面同名 MCP_* 键。所以只填 MCP_RAGFLOW_BASE_URL 也能跑 local profile，
# LOCAL_* 只在「本地和容器要连不同 RAGFlow」时才需要单独写。
LOCAL_MCP_PLATFORM_BASE_URL=
LOCAL_MCP_RAGFLOW_BASE_URL=
LOCAL_MCP_RAGFLOW_API_KEY=
LOCAL_LLM_AUTH_URL=

# ---- 平台登录凭据（SEC-02） ----
PLATFORM_LOGIN_USERNAME=
PLATFORM_LOGIN_PASSWORD=
PLATFORM_LOGIN_TYPE=1
PLATFORM_CAPTCHA_ID=
PLATFORM_CAPTCHA_CODE=
PLATFORM_ALLOW_PLAINTEXT_LOGIN=false

# ---- Redis（compose 会转成 SPRING_DATA_REDIS_* 注入） ----
# 连本文件自带的 redis 容器要同时开 --profile redis 且 REDIS_HOST=redis；
# 保持 localhost 等于连容器自己，health 会显示 redis DOWN。
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=10

# ---- 数据库 / SSL / Kafka ----
DB_URL=
DB_USERNAME=
DB_PASSWORD=
SSL_KEY_STORE=
SSL_KEY_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=

# ---- 跨域白名单（server 环境） ----
SECURITY_ALLOWED_ORIGINS=

# ---- 内网 MCP 应用层鉴权（SEC-08） ----
# /mcp/** 的 API Key。留空 = 所有 MCP 请求 401，这是默认拒绝，不是放行。
# 生成：openssl rand -hex 32
# agent 侧必须配置同一个值，并通过 Authorization: Bearer <key> 或 X-MCP-API-Key 头携带。
MCP_API_KEY=
# 本地非容器运行保持空（默认绑 127.0.0.1）；容器内由 docker-compose 注入 0.0.0.0。
# MCP_INTERNAL_ADDRESS=0.0.0.0

# ----------------------------------------------------------------------------
# 十、知识库检索（agentic-app 直连平台检索接口，mcp_client/knowledge_http_client.py）
# ----------------------------------------------------------------------------
# 配了 KB_BASE_URL + KB_API_KEY 就走平台 HTTP 直连（路径更短、报错好定位）；
# 两个都留空才回落到 sidecar 的 /mcp/knowledge（依赖上面那份 RAGFlow 配置）。
# 空串一律按"未设置"处理，不会把默认值冲掉。
#
# 例：KB_BASE_URL=http://10.204.146.44:8082
KB_BASE_URL=http://10.204.156.138:8069
# 平台给的 Bearer 值，例：dataset-xxxxxxxx
KB_API_KEY=
KB_RETRIEVAL_PATH=/v1/api_key/datasets/draft
# 知识库 ID，英文逗号分隔；留空 = 不指定范围（由接口默认）
KB_DATASET_IDS=1100058
KB_TOP_K=5
# 例：0.13；留空 = 不传该字段
KB_SCORE_THRESHOLD=
# 1=开重排，0=关
KB_RERANK_ENABLE=0
KB_RERANK_PROVIDER=
KB_RERANK_MODEL=
KB_TIMEOUT=20
# 单条片段喂给模型时的最大字符数
KB_SEGMENT_MAX_CHARS=800
KB_VECTOR_WEIGHT=0.3
KB_KEYWORD_WEIGHT=0.7